generator client {
  provider = "prisma-client"
  output   = "../lib/generated/analytics"
}

datasource db {
  provider = "postgresql"
  schemas  = ["dbo"]
}

enum Role {
  admin
  client

  @@schema("dbo")
}

enum CompanyAccessRole {
  proprietario @map("administrator")
  analista     @map("analyst")

  @@map("company_access_role")
  @@schema("dbo")
}

/// Espelho das tabelas compartilhadas (Analytics/Fractal). Migrate roda no Fractal-Api.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?  @map("password_hash")
  role         Role     @default(client)
  planActive   Boolean  @default(false) @map("plan_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("cad_usuario")
  @@schema("dbo")
}

model LoginOtp {
  email        String   @id
  codeHash     String   @map("code_hash")
  expiresAt    DateTime @map("expires_at")
  attemptCount Int      @default(0) @map("attempt_count")

  @@map("aux_login_otp")
  @@schema("dbo")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  companies    Company[]
  accessGrants AccessGrant[]

  @@map("cad_organizacao")
  @@schema("dbo")
}

model Company {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  name           String
  planActive     Boolean              @default(false) @map("plan_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantLinks     AccessGrantCompany[]

  @@index([organizationId])
  @@map("cad_empresa")
  @@schema("dbo")
}

model AccessGrant {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  email             String
  allCompanies      Boolean              @default(true) @map("all_companies")
  isOwner        Boolean              @default(false) @map("is_owner")
  createdAt         DateTime             @default(now()) @map("created_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies         AccessGrantCompany[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("cad_acesso")
  @@schema("dbo")
}

model AccessGrantCompany {
  grantId   String            @map("grant_id")
  companyId String            @map("company_id")
  role      CompanyAccessRole @default(analista)
  grant     AccessGrant       @relation(fields: [grantId], references: [id], onDelete: Cascade)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([grantId, companyId])
  @@map("cad_acesso_empresa")
  @@schema("dbo")
}
