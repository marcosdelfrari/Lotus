generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  requested
  sent
  accepted
  cancelled
}

// Propostas ficam só no banco da Lótus. userId aponta para users.id no banco do Analytics, sem FK.
model TrafficProposal {
  id     String @id @default(uuid())
  userId String @map("user_id")

  companyName        String  @map("company_name")
  segment            String  @default("")
  monthlyMediaBudget Int?    @map("monthly_media_budget")
  goals              String  @default("")
  contactPhone       String  @default("") @map("contact_phone")

  title              String?
  scope              Json    @default("[]")
  services           Json    @default("[]")
  adBudgetSuggestion Int?    @map("ad_budget_suggestion")
  deadlineDays       Int?    @map("deadline_days")
  conditions         Json    @default("[]")
  validUntil         DateTime? @map("valid_until") @db.Date

  status     ProposalStatus @default(requested)
  acceptedAt DateTime?      @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("traffic_proposals")
}

// Lead que deixou o WhatsApp depois do login com Google.
model Interest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String
  whatsapp  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("interessados")
}
