generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  draft
  requested
  sent
  accepted
  cancelled
}

enum BillingItemKind {
  setup
  monthly
}

enum BillingItemStatus {
  pending
  paid
}

// Propostas ficam só no banco da Lótus. userId aponta para users.id no banco do Analytics, sem FK.
// clientEmail espelha o login (Analytics) no save — evita join só para listar/enviar e permite achar proposta pelo e-mail.
model TrafficProposal {
  id     String @id @default(uuid())
  userId String @map("user_id")

  clientEmail String @default("") @map("client_email")
  clientName  String @default("") @map("client_name")

  companyName        String  @map("company_name")
  segment            String  @default("")
  monthlyMediaBudget Int?    @map("monthly_media_budget")
  goals              String  @default("")
  contactPhone       String  @default("") @map("contact_phone")

  intro              String  @default("")
  title              String?
  scope              Json    @default("[]")
  services           Json    @default("[]")
  setupFee           Int?    @map("setup_fee")
  adBudgetSuggestion Int?    @map("ad_budget_suggestion")
  deadlineDays       Int?    @map("deadline_days")
  implementationPlan Json    @default("[]") @map("implementation_plan")
  conditions         Json    @default("[]")
  terms              Json    @default("[]")
  validUntil         DateTime? @map("valid_until") @db.Date

  status     ProposalStatus @default(requested)
  acceptedAt DateTime?      @map("accepted_at")
  acceptance Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  billingItems ProposalBillingItem[]
  marketingPlans MarketingPlan[]

  @@index([userId])
  @@index([clientEmail])
  @@map("traffic_proposals")
}

enum MarketingPlanStatus {
  draft
  saved
}

/// Plano de marketing / proposta de campanha — operação Lótus (por proposta + empresa Analytics).
model MarketingPlan {
  id                 String              @id @default(uuid())
  proposalId         String              @map("proposal_id")
  /// companies.id no banco Analytics (sem FK entre bancos).
  analyticsCompanyId String              @map("analytics_company_id")
  operationProposal  String              @map("operation_proposal")
  funnelTouchpoints  String[]            @default([]) @map("funnel_touchpoints")
  mediaChannels      String[]            @default([]) @map("media_channels")
  adFormats          String[]            @default([]) @map("ad_formats")
  notes              String              @default("")
  customAssets       String              @default("") @map("custom_assets")
  status             MarketingPlanStatus @default(saved)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  proposal           TrafficProposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, analyticsCompanyId])
  @@index([proposalId])
  @@map("marketing_plans")
}

model ProposalBillingItem {
  id         String @id @default(uuid())
  proposalId String @map("proposal_id")

  kind     BillingItemKind
  label    String
  amount   Int
  dueDate  DateTime?         @db.Date @map("due_date")
  status   BillingItemStatus @default(pending)
  paidAt   DateTime?         @map("paid_at")
  sequence Int               @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proposal TrafficProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([status])
  @@map("proposal_billing_items")
}

// Lead que deixou o WhatsApp depois do login com Google.
model Interest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String
  whatsapp  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("interessados")
}
