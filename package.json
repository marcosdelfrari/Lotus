{
  "name": "lotus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma generate --config prisma/analytics.config.ts && next dev",
    "build": "prisma generate && prisma generate --config prisma/analytics.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate && prisma generate --config prisma/analytics.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate && prisma generate --config prisma/analytics.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "framer-motion": "^14.4.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
